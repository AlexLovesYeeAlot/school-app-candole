@model IEnumerable<SchoolApp.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

@* Option B: live search. No form and no button: it filters while you type *@
<input type="text" id="searchBox" class="form-control mb-3"
    placeholder="Live search - Alex" />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StudentNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BirthDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="studentRows">
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StudentNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Age)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BirthDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StudentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StudentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StudentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
<script>
    // Runs every time a key is typed in the search box
    document.getElementById("searchBox").addEventListener("input", function () {
        // What the user typed, in lowercase so "MARIA" matches "Maria"
        const text = this.value.toLowerCase();

        // Look at every row in the table
        document.querySelectorAll("#studentRows tr").forEach(function (row) {
            // Student No. (cell 0), Full Name (cell 1) and Email (cell 2) together
            const rowText = (row.cells[0].textContent + " " +
                row.cells[1].textContent + " " +
                row.cells[2].textContent).toLowerCase();

            // Show the row if it contains the text, hide it if not
            row.style.display = rowText.includes(text) ? "" : "none";
        });
    });
</script>
}

